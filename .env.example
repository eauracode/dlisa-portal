# Copy to .env.local (development) or set in your hosting provider. Placeholders only.

# --- Database (PostgreSQL 13+; Supabase works: use the pooled or direct connection string)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# "true" for hosted databases that require TLS (e.g. Supabase)
DATABASE_SSL=false

# --- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
# Used to pseudonymise client addresses for rate limiting and reporter codes. Min 32 chars.
APP_SECRET=replace-with-a-long-random-value
# Bearer token for the scheduled maintenance endpoint /api/jobs/process. Min 16 chars.
CRON_SECRET=replace-with-another-long-random-value

# Number of reverse proxies in front of the app whose X-Forwarded-For entry is trusted
# (1 on Vercel or behind a single load balancer; 0 when the app is reached directly).
TRUSTED_PROXY_COUNT=1

# --- AI Issue Intelligence Engine (see README "AI Issue Intelligence Engine")
# Classifier (structured understanding of each complaint):
#   local      = rules on this server (no text leaves it)
#   anthropic  = Claude via ANTHROPIC_API_KEY (structured outputs)
#   openai     = any OpenAI-compatible API (OpenAI, Azure gateway, self-hosted Ollama/vLLM)
AI_CLASSIFIER_PROVIDER=local
# Embeddings (semantic similarity):
#   transformers = RECOMMENDED. Real semantic model running on this server, no API key,
#                  text never leaves the server. Downloads ~23 MB once into MODEL_CACHE_DIR.
#   openai       = OpenAI-compatible embeddings API
#   local        = lexical fallback (no model download)
AI_EMBEDDING_PROVIDER=transformers
LOCAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
MODEL_CACHE_DIR=./.models
# Match verifier (second opinion before automatic grouping). Defaults to the classifier
# provider; "local" uses deterministic attribute rules.
# AI_VERIFIER_PROVIDER=anthropic
AI_TIMEOUT_MS=10000

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Worker
WORKER_INTERVAL_SECONDS=60
